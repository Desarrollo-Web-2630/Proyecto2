{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/procesos-front/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://proyecto1-bach.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
